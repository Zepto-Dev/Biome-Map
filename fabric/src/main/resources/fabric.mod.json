{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Adds /biomemap, which exports a Chunkbase-style biome and structure map of the current world's seed as a PNG and an interactive HTML viewer. It asks your modpack's real world generator, so modded biomes and structures show up exactly where they will generate.",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_source_url}",
    "sources": "${mod_source_url}",
    "issues": "${mod_source_url}/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "accessWidener": "biomemap.accesswidener",
  "entrypoints": {
    "main": [
      "io.github.zeptodev.biomemap.BiomeMapFabric"
    ],
    "client": [
      "io.github.zeptodev.biomemap.BiomeMapFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_min}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  }
}
